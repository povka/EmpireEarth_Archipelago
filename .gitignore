# The built apworld IS tracked: it is what people download and drop into
# Archipelago's custom_worlds folder. Rebuild it with build_apworld.ps1 and
# commit the result whenever the world changes.

# Generated multiworlds and spoilers
/output/

# Reverse-engineering and development tooling. Not part of the apworld and
# not needed to build or run it: memory scanners, disassembly helpers, RTTI
# and archive readers, and the one-off probes used to find the addresses
# documented in notes/REVERSE.md.
#
# Two of these are arguably worth tracking if you ever want to regenerate or
# test outside an Archipelago source checkout:
#   tools/gen_objects.py     - regenerates world/empire_earth/Objects.py
#   tools/test_generation.py - drives ArchipelagoGenerate over every option
# Un-ignore them with:  git add -f tools/gen_objects.py
/tools/

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Editor / OS noise
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
